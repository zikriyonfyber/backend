# ZEAIPC / Zikriyon Fyber backend — copy to .env and fill in real values.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.zikriyonfyber.net,localhost

DB_NAME=zeaipc
DB_USER=zeaipc
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

KAMAILIO_DB_NAME=kamailio
KAMAILIO_DB_USER=kamailio
KAMAILIO_DB_PASSWORD=replace-me
KAMAILIO_DB_HOST=localhost
KAMAILIO_DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

ROUTER_SHARED_SECRET=replace-me
SIP_SERVER_SECRET=replace-me
SIP_DOMAIN=sip.zikriyonfyber.net
SIP_NUMBER_PREFIX=92700

WEATHER_PROVIDER_API_KEY=replace-me

CORS_ALLOWED_ORIGINS=https://portal.zikriyonfyber.net,https://admin.zeaipc.net
